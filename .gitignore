# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.md
!README.md
*.resolved
*.sql
# Migrations are the schema's history — they must be tracked.
!prisma/migrations/**/*.sql
# Leftover SQLite file from before the move to MySQL.
prisma/dev.db
plan.html
planning/
# Local one-off scripts stay out; the CRM importer is a documented command
# (`pnpm crm:import`), so it ships. The directory itself must stay unignored —
# git cannot re-include a file whose parent directory is excluded.
/scripts/*
!/scripts/import-crm.ts
*.gs
data-export.json
*.zip
docker-compose.yml
dockerfile
.dockerignore
#deploy.sh

# uploads
public/uploads/
/storage/claims/
test-smtp.js
.claude/
.impeccable/
crm.xlsx
